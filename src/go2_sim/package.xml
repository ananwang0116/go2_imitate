<?xml version="1.0"?>
<package format="3">
  <name>go2_sim</name><version>0.1.0</version>
  <description>Isolated Gazebo fixed-map simulation for the imported Go2 planner.</description>
  <maintainer email="local@example.com">Go2 project</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>gazebo_ros</exec_depend><exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>go2_common</exec_depend><exec_depend>go2_msgs</exec_depend><exec_depend>go2_per</exec_depend>
  <exec_depend>go2_description</exec_depend><exec_depend>go2_bringup</exec_depend>
